# Порт API
PORT=4000

# Рабочая база MongoDB Atlas (имя базы в конце строки: /studytrack)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/studytrack?retryWrites=true&w=majority

# Отдельная база для автотестов. Имя обязательно оканчивается на _test: тесты ее очищают
MONGODB_URI_TEST=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/studytrack_test?retryWrites=true&w=majority

# Адрес сайта Next.js (для CORS). Несколько адресов - через запятую
WEB_ORIGIN=http://localhost:3000

# Секрет подписи JWT, не короче 32 символов. Сгенерировать:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Сервис отчетов (report-service). Ключ тот же, что REPORT_SERVICE_KEY в report-service/.env
REPORT_SERVICE_URL=http://127.0.0.1:4100
REPORT_SERVICE_KEY=